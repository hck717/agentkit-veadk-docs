{"set": "jev_tools", "id": "js_calc_01", "type": "tool_call", "prompt": "P&L 對數：長倉 (42*17) 再加 9 係 723，想分返 3 份。計 (42*17+9)/3 幾多。用 calc 工具。", "context": "", "golden": {"tool": "calc", "args": {"expr": "(42*17+9)/3"}, "result": 241.0, "variants": ["(42*17+9)/3", "(42 * 17 + 9) / 3"], "check": "result"}, "evaluator": "tool_call", "meta": {"lang": "yue"}}
{"set": "jev_tools", "id": "js_calc_02", "type": "tool_call", "prompt": "TSMC 開倉價 187，target 係 +15%。計 target 價。用 calc 工具。", "context": "", "golden": {"tool": "calc", "args": {"expr": "187*1.15"}, "result": 215.05, "variants": ["187*1.15", "187 * 1.15", "187.0*1.15"], "check": "result"}, "evaluator": "tool_call", "meta": {"lang": "yue"}}
{"set": "jev_tools", "id": "js_read_01", "type": "tool_call", "prompt": "用 read_news_file 讀 data/news/sample_news.csv 第三行，話我知 ticker 同 sentiment。", "context": "", "golden": {"tool": "read_news_file", "args": {"path": "data/news/sample_news.csv"}, "fields": ["ticker", "sentiment"], "expect": {"ticker": "TSM", "sentiment": "neutral"}, "row": 2, "check": "fields"}, "evaluator": "tool_call", "meta": {"lang": "yue"}}
